{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate.schema.json",
  "type": "object",
  "required": ["schema_version", "candidates"],
  "additionalProperties": false,
  "properties": {"schema_version": {"type": "string", "minLength": 1}, "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}},
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_ref": {"type": "object", "required": ["source_id", "locator"], "additionalProperties": false, "properties": {"source_id": {"$ref": "#/$defs/uuid"}, "locator": {"type": "string", "minLength": 1}}},
    "option": {"type": "object", "required": ["option_id", "candidate_id", "option_revision", "normalized_text_fingerprint", "current_position", "source_label", "source_ref", "previous_labels"], "additionalProperties": false, "properties": {"option_id": {"$ref": "#/$defs/uuid"}, "candidate_id": {"$ref": "#/$defs/uuid"}, "option_revision": {"type": "integer", "minimum": 1}, "normalized_text_fingerprint": {"$ref": "#/$defs/hash"}, "current_position": {"type": "integer", "minimum": 1}, "source_label": {"type": "string", "minLength": 1}, "source_ref": {"$ref": "#/$defs/source_ref"}, "previous_labels": {"type": "array", "items": {"type": "string"}}}},
    "fingerprints": {"type": "object", "required": ["stem_fingerprint", "option_set_fingerprint", "content_revision_fingerprint"], "additionalProperties": false, "properties": {"stem_fingerprint": {"$ref": "#/$defs/hash"}, "option_set_fingerprint": {"$ref": "#/$defs/hash"}, "content_revision_fingerprint": {"$ref": "#/$defs/hash"}}},
    "candidate": {"type": "object", "required": ["candidate_id", "candidate_revision", "source_id", "locator", "question_type", "status", "stem", "fingerprints", "options", "duplicate_group"], "additionalProperties": false, "properties": {"candidate_id": {"$ref": "#/$defs/uuid"}, "candidate_revision": {"type": "integer", "minimum": 1}, "source_id": {"$ref": "#/$defs/uuid"}, "locator": {"type": "string", "minLength": 1}, "question_type": {"enum": ["single_choice", "multiple_choice", "true_false", "unsupported", "ambiguous"]}, "status": {"enum": ["candidate", "validated", "unsupported", "ambiguous", "archived"]}, "stem": {"type": "string", "minLength": 1}, "fingerprints": {"$ref": "#/$defs/fingerprints"}, "options": {"type": "array", "items": {"$ref": "#/$defs/option"}}, "duplicate_group": {"type": ["string", "null"]}}}
  }
}
