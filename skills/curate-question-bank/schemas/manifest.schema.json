{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "dataset_id", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {"type": "object", "required": ["source_id", "kind", "current_relative_path", "path_history", "current_content_hash", "revision"], "additionalProperties": false, "properties": {"source_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "kind": {"enum": ["question_document", "answer_document", "unrelated", "duplicate_version"]}, "current_relative_path": {"type": "string", "minLength": 1}, "path_history": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "current_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "revision": {"type": "integer", "minimum": 1}}}
  }
}
