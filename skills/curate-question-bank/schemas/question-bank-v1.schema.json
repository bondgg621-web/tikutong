{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "question-bank-v1.schema.json",
  "title": "QBC Canonical Question Bank v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bank_id",
    "title",
    "questions",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "bank_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "question-item.schema.json"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/source_record"
      }
    }
  },
  "definitions": {
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_file",
        "source_type"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "pdf",
            "docx",
            "image",
            "text",
            "markdown",
            "structured"
          ]
        }
      }
    }
  }
}
