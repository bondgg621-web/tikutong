{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "extracted-question-v1.schema.json",
  "title": "QBC Assisted Intake ExtractedQuestion Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questions"
  ],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/extracted_question"
      }
    }
  },
  "definitions": {
    "extracted_option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "text"
      ],
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extracted_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_type",
        "stem",
        "options",
        "source_reference"
      ],
      "properties": {
        "question_type": {
          "type": "string",
          "enum": [
            "single_choice",
            "multiple_choice",
            "true_false"
          ]
        },
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extracted_option"
          }
        },
        "answer": {},
        "explanation": {
          "type": [
            "string",
            "null"
          ]
        },
        "chapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_reference": {
          "$ref": "#/definitions/source_reference"
        },
        "extraction_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "single_choice"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "minItems": 2,
                "maxItems": 5
              },
              "answer": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  null
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "multiple_choice"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "minItems": 2,
                "maxItems": 5
              },
              "answer": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D",
                        "E"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "true_false"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "maxItems": 0
              },
              "answer": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
