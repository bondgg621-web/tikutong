{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.schema.json",
  "type": "object", "required": ["schema_version", "decisions"], "additionalProperties": false,
  "properties": {"schema_version": {"type": "string", "minLength": 1}, "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}},
  "$defs": {"uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "evidence": {"type": "object", "required": ["source_id", "source_revision", "locator", "evidence_fingerprint"], "additionalProperties": false, "properties": {"source_id": {"$ref": "#/$defs/uuid"}, "source_revision": {"type": "integer", "minimum": 1}, "locator": {"type": "string", "minLength": 1}, "evidence_fingerprint": {"$ref": "#/$defs/hash"}}}, "decision": {"type": "object", "required": ["decision_id", "candidate_id", "candidate_revision", "decision_type", "value", "evidence", "status"], "additionalProperties": false, "properties": {"decision_id": {"$ref": "#/$defs/uuid"}, "candidate_id": {"$ref": "#/$defs/uuid"}, "candidate_revision": {"type": "integer", "minimum": 1}, "decision_type": {"enum": ["answer_resolution", "duplicate_relation", "association"]}, "value": {"type": "object"}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "status": {"enum": ["valid", "needs_revalidation", "archived"]}}}}
}
