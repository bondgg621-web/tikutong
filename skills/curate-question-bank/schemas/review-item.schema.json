{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-item.schema.json",
  "type": "object", "required": ["schema_version", "review_items"], "additionalProperties": false,
  "properties": {"schema_version": {"type": "string", "minLength": 1}, "review_items": {"type": "array", "items": {"$ref": "#/$defs/review"}}},
  "$defs": {"uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "review": {"type": "object", "required": ["review_id", "issue_code", "blocking_level", "status", "allowed_user_actions"], "additionalProperties": false, "properties": {"review_id": {"$ref": "#/$defs/uuid"}, "candidate_id": {"$ref": "#/$defs/uuid"}, "issue_code": {"enum": ["QB-SOURCE-UNSUPPORTED", "QB-SOURCE-READ-FAILED", "QB-ROLE-AMBIGUOUS", "QB-TYPE-UNSUPPORTED", "QB-STRUCTURE-AMBIGUOUS", "QB-ANSWER-MISSING", "QB-ANSWER-CONFLICT", "QB-ASSOCIATION-LOW-CONFIDENCE", "QB-DUPLICATE-CANDIDATE", "QB-IDENTITY-AMBIGUOUS", "QB-OPTION-IDENTITY-AMBIGUOUS", "QB-DECISION-STALE", "QB-FORMAT-LOSS", "QB-SECURITY-INSTRUCTION-DATA", "QB-REMOTE-CAPABILITY-NOT-AUTHORIZED"]}, "blocking_level": {"enum": ["blocking", "review_required", "informational"]}, "status": {"enum": ["open", "resolved", "archived"]}, "allowed_user_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}}
}
