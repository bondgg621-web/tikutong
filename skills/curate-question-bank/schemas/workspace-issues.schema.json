{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-issues.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "issues"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "issues": {"type": "array", "items": {"type": "object", "required": ["issue_id", "code", "status", "summary", "relative_paths", "source_ids"], "additionalProperties": false, "properties": {"issue_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "code": {"enum": ["QB-SOURCE-UNSUPPORTED", "QB-SOURCE-READ-FAILED", "QB-IDENTITY-AMBIGUOUS"]}, "status": {"enum": ["open", "resolved"]}, "summary": {"type": "string", "minLength": 1}, "relative_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}}}}
  }
}
