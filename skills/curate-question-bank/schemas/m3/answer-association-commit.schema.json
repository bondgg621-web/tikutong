{
  "$id": "answer-association-commit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "interchange_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "parent_pointer_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "provenance_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "transaction_id",
    "snapshot_id",
    "plan_hash",
    "parent_pointer_hash",
    "interchange_hash",
    "provenance_hash"
  ],
  "type": "object"
}
