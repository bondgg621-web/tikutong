{
  "$id": "answer-association-reverify.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answer_source_ids": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "expected_before_pointer": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "manifest_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\\\]+$",
      "type": "string"
    },
    "question_source_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "recorded_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "type": "string"
    },
    "required_decision_ids": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "result_snapshot_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "result_transaction_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "current_conclusion": {
            "enum": [
              "confirmable",
              "conflict",
              "missing",
              "low_confidence",
              "adjudicated"
            ]
          },
          "current_evidence": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "evidence_fingerprint": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "evidence_id": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "locator": {
                  "pattern": "^line:[1-9][0-9]*$",
                  "type": "string"
                },
                "question_number": {
                  "minimum": 1,
                  "type": "integer"
                },
                "resolved_option_id": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                      "type": "string"
                    }
                  ]
                },
                "source_id": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "source_lexeme": {
                  "pattern": "^[A-Z]$",
                  "type": "string"
                },
                "source_revision": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "evidence_id",
                "source_id",
                "source_revision",
                "locator",
                "question_number",
                "source_lexeme",
                "evidence_fingerprint",
                "resolved_option_id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "current_semantic_keys": {
            "items": {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "current_source_ids": {
            "items": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "type": "array"
          },
          "decision_id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "issue_code": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "QB-DECISION-STALE",
                  "QB-ANSWER-CONFLICT"
                ]
              }
            ]
          },
          "mappings": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "current_instances": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "evidence_fingerprint": {
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "locator": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "question_number": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "resolved_option_id": {
                        "oneOf": [
                          {
                            "type": "null"
                          },
                          {
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                            "type": "string"
                          }
                        ]
                      },
                      "source_id": {
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                        "type": "string"
                      },
                      "source_revision": {
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "source_id",
                      "source_revision",
                      "locator",
                      "question_number",
                      "evidence_fingerprint",
                      "resolved_option_id"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "current_semantic_key": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "maxItems": 3,
                      "minItems": 3,
                      "prefixItems": [
                        {
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                          "type": "string"
                        },
                        {
                          "minimum": 1,
                          "type": "integer"
                        },
                        {
                          "pattern": "^[0-9a-f]{64}$",
                          "type": "string"
                        }
                      ],
                      "type": "array"
                    }
                  ]
                },
                "historical_instance": {
                  "additionalProperties": false,
                  "properties": {
                    "evidence_fingerprint": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "locator": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "source_id": {
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                      "type": "string"
                    },
                    "source_revision": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "source_id",
                    "source_revision",
                    "locator",
                    "evidence_fingerprint"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "historical_instance",
                "current_semantic_key",
                "current_instances"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "original_source_ids": {
            "items": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "type": "array"
          },
          "result": {
            "enum": [
              "valid",
              "needs_revalidation"
            ]
          },
          "review_item_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "decision_id",
          "result",
          "issue_code",
          "review_item_id",
          "current_conclusion",
          "original_source_ids",
          "current_source_ids",
          "current_semantic_keys",
          "current_evidence",
          "mappings"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "reverify_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "decision_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "kind": {
              "const": "decision"
            }
          },
          "required": [
            "kind",
            "decision_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "question_source"
            },
            "question_source_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "question_source_id"
          ],
          "type": "object"
        }
      ]
    },
    "unavailable_source_ids": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "reverify_id",
    "scope",
    "expected_before_pointer",
    "question_source_id",
    "manifest_path",
    "manifest_hash",
    "required_decision_ids",
    "answer_source_ids",
    "unavailable_source_ids",
    "results",
    "recorded_at",
    "result_transaction_id",
    "result_snapshot_id"
  ],
  "type": "object"
}
