{
  "$id": "answer-association-confirmation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confirmation_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "considered_semantic_keys": {
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "type": "array"
    },
    "expected_candidate_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expected_current_pointer": {
      "oneOf": [
        {
          "const": "ABSENT"
        },
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "proposal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "proposal_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\\\]+$",
      "type": "string"
    },
    "proposal_run_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "recorded_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "type": "string"
    },
    "rejected_semantic_keys": {
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "type": "array"
    },
    "request": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "confirm"
            },
            "proposal_ids": {
              "items": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            },
            "selected_evidence_ids": {
              "items": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              "maxItems": 0,
              "type": "array"
            }
          },
          "required": [
            "action",
            "proposal_ids",
            "selected_evidence_ids"
