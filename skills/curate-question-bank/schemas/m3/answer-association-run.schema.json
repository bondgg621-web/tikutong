{
  "$id": "answer-association-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "phase": {
          "enum": [
            "source_resolution",
            "snapshot_validation",
            "answer_parse",
            "association",
            "review",
            "confirmation",
            "publication",
            "read_back"
          ]
        },
        "result": {
          "type": "null"
        },
        "status": {
          "const": "running"
        }
      }
    },
    {
      "properties": {
        "phase": {
          "const": "complete"
        },
        "result": {
          "type": "null"
        },
        "status": {
          "const": "failed"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "prepare"
        },
        "phase": {
          "const": "complete"
        },
        "result": {
          "additionalProperties": false,
          "properties": {
            "direct_pointer": {
              "oneOf": [
                {
                  "const": "ABSENT"
                },
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "direct_pointer"
          ],
          "type": "object"
        },
        "status": {
          "enum": [
            "complete",
            "needs_confirmation",
            "needs_review"
          ]
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "prepare"
        },
        "phase": {
          "const": "complete"
        },
        "result": {
          "additionalProperties": false,
          "properties": {
            "commit_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "current_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "snapshot_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "transaction_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "transaction_state_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "transaction_id",
            "transaction_state_hash",
            "snapshot_id",
            "current_hash",
            "commit_hash"
          ],
          "type": "object"
        },
        "status": {
          "enum": [
            "complete",
            "needs_confirmation",
            "needs_review"
          ]
        }
      }
    },
    {
      "properties": {
        "operation": {
          "enum": [
            "confirm",
            "reverify"
          ]
        },
        "phase": {
          "const": "complete"
        },
        "result": {
          "additionalProperties": false,
          "properties": {
            "commit_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "current_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "snapshot_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "transaction_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "transaction_state_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "transaction_id",
            "transaction_state_hash",
            "snapshot_id",
            "current_hash",
            "commit_hash"
          ],
          "type": "object"
        },
        "status": {
          "const": "complete"
        }
      }
    }
  ],
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "relative_path": {
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\\\]+$",
            "type": "string"
          }
        },
        "required": [
          "relative_path",
          "content_hash"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "operation": {
      "enum": [
        "prepare",
        "confirm",
        "reverify",
        "recover"
      ]
    },
    "phase": {
      "enum": [
        "source_resolution",
        "snapshot_validation",
        "answer_parse",
        "association",
        "review",
        "confirmation",
        "publication",
        "read_back",
        "complete"
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "commit_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "current_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "snapshot_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "transaction_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "transaction_state_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "transaction_id",
            "transaction_state_hash",
            "snapshot_id",
            "current_hash",
            "commit_hash"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "direct_pointer": {
              "oneOf": [
                {
                  "const": "ABSENT"
                },
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "direct_pointer"
          ],
          "type": "object"
        }
      ]
    },
    "run_findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocking_level": {
            "enum": [
              "blocking",
              "review_required",
              "informational"
            ]
          },
          "candidate_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              }
            ]
          },
          "issue_code": {
            "pattern": "^QB-",
            "type": "string"
          },
          "option_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              }
            ]
          },
          "source_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "issue_code",
          "blocking_level",
          "source_id",
          "candidate_id",
          "option_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "started_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "complete",
        "needs_confirmation",
        "needs_review",
        "failed"
      ]
    },
    "updated_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "operation",
    "status",
    "phase",
    "started_at",
    "updated_at",
    "artifacts",
    "run_findings",
    "result"
  ],
  "type": "object"
}
