{
  "$id": "answer-association-pointer.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "ABSENT"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "commit_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "commit_path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\\\]+$",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "type": "integer"
        },
        "parent_pointer_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "snapshot_path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\\\]+$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "dataset_id",
        "snapshot_id",
        "snapshot_path",
        "commit_path",
        "commit_hash",
        "parent_pointer_hash",
        "generation"
      ],
      "type": "object"
    }
  ]
}
