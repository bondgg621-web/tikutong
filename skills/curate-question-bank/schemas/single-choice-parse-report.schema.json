{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "single-choice-parse-report.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "parser_contract_version",
    "run_id",
    "status",
    "source_id",
    "source_revision",
    "source_relative_path",
    "source_content_hash",
    "question_like_block_count",
    "accepted_candidate_count",
    "rejected_block_count",
    "finding_count",
    "candidate_artifact_relative_path",
    "candidate_artifact_content_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "parser_contract_version": {"type": "string", "const": "m2-single-choice-v1"},
    "run_id": {"type": "string", "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "status": {"type": "string", "enum": ["complete", "needs_review", "failed"]},
    "source_id": {"type": "string", "pattern": "^(?!.*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "source_revision": {"type": "integer", "minimum": 1},
    "source_relative_path": {"type": "string", "minLength": 1},
    "source_content_hash": {"type": "string", "pattern": "^(?!.*[\\r\\n])[0-9a-f]{64}$"},
    "question_like_block_count": {"type": "integer", "minimum": 0},
    "accepted_candidate_count": {"type": "integer", "minimum": 0},
    "rejected_block_count": {"type": "integer", "minimum": 0},
    "finding_count": {"type": "integer", "minimum": 0},
    "candidate_artifact_relative_path": {"type": ["string", "null"], "minLength": 1},
    "candidate_artifact_content_hash": {"type": ["string", "null"], "pattern": "^(?!.*[\\r\\n])[0-9a-f]{64}$"}
  }
}
